# Backend configuration. Configure real values in Render's Environment settings.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/quickhire?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Public application origins used for CORS and email links.
CLIENT_URL=https://your-client.example.com
FRONTEND_URL=https://your-client.example.com
ADMIN_URL=https://your-admin.example.com

# Email: SMTP is used by authentication emails; RESEND_API_KEY is optional for service emails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SENDER_EMAIL=verified-sender@example.com
SENDER_NAME=QuickHire Team
OTP_EXPIRY_MINUTES=10
RESEND_API_KEY=replace_with_resend_api_key

# Payments
RAZ_API_KEY=replace_with_razorpay_key_id
RAZ_SECRET_KEY=replace_with_razorpay_key_secret

# Optional AI and matching settings
GROQ_API_KEY=replace_with_groq_api_key
MATCH_THRESHOLD=0.7
MAX_NOTIFICATION_CANDIDATES=100
